{
  "name": "hyperai-user-control-system-mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "eas:init": "npx eas-cli@latest init",
    "eas:build:ios": "npx eas-cli@latest build -p ios --profile production",
    "eas:build:android": "npx eas-cli@latest build -p android --profile production",
    "eas:build:all": "npx eas-cli@latest build --profile production",
    "eas:submit:ios": "npx eas-cli@latest submit -p ios --profile production",
    "eas:submit:android": "npx eas-cli@latest submit -p android --profile production",
    "eas:release:ios": "npx eas-cli@latest build -p ios --profile production --submit",
    "eas:release:android": "npx eas-cli@latest build -p android --profile production --submit",
    "eas:build:list": "npx eas-cli@latest build:list",
    "eas:submit:list": "npx eas-cli@latest submit:list",
    "test": "jest",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "17.0.2",
    "react-native": "0.64.2",
    "react-navigation": "^4.4.4",
    "axios": "^0.21.1",
    "react-native-gesture-handler": "^1.10.3",
    "react-native-reanimated": "^2.2.0",
    "react-native-screens": "^3.8.0",
    "react-native-safe-area-context": "^3.3.2"
  },
  "devDependencies": {
    "@babel/core": "^7.12.10",
    "@babel/runtime": "^7.12.5",
    "babel-jest": "^26.6.3",
    "eslint": "^7.14.0",
    "jest": "^26.6.3",
    "metro-react-native-babel-preset": "^0.66.2"
  },
  "jest": {
    "preset": "react-native"
  }
}
