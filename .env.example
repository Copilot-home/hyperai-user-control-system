# HyperAI User Control System — Environment Contract
# Copy this file to .env only when an optional integration needs configuration.
# Never commit a real .env or credential file.

# -----------------------------------------------------------------------------
# CORE LOCAL RUNTIME
# -----------------------------------------------------------------------------
# Backend/server.js defaults to port 5000.
PORT=5000

# Browser API settings. The deterministic build defaults VITE_API_BASE_URL to
# /api when HYPERAI_BUILD_API_BASE_URL is not supplied.
VITE_API_BASE_URL=/api
VITE_API_ORIGIN=
# Leave empty to derive ws:// or wss:// from the active API/browser origin.
VITE_WEBSOCKET_URL=

# -----------------------------------------------------------------------------
# OPTIONAL RUNTIME LANES
# -----------------------------------------------------------------------------
# False keeps optional lanes in their existing disabled/local-only behavior.
VITE_ENABLE_CHAT_RUNTIME=false
VITE_ENABLE_USER_RUNTIME=false
VITE_ENABLE_NOTEBOOKLM_RUNTIME=false
VITE_ENABLE_WEBSOCKET_RUNTIME=false
VITE_ENABLE_SYMPHONY_RUNTIME=false

# -----------------------------------------------------------------------------
# BUILD / MANAGED-RUNTIME TOOLING
# -----------------------------------------------------------------------------
HYPERAI_BUILD_API_BASE_URL=/api
HYPERAI_DEFAULT_BACKEND_PORT=5000
HYPERAI_DEFAULT_FRONTEND_PORT=4173
HYPERAI_FALLBACK_BACKEND_PORT=5001
HYPERAI_FALLBACK_FRONTEND_PORT=4177
HYPERAI_RUNTIME_RECOVERY_COOLDOWN_MS=120000
SMOKE_TIMEOUT_MS=60000
HYPERAI_DRILL_SKIP_BROWSER_SMOKE=false

# Optional path to a local Python interpreter used by connector/probe helpers.
PYTHON=python

# -----------------------------------------------------------------------------
# VERCEL / CLOUD PROXY — OPTIONAL
# -----------------------------------------------------------------------------
# The Vercel API proxy fails closed when HYPERAI_UPSTREAM_URL is unset.
HYPERAI_UPSTREAM_URL=
HYPERAI_PUBLIC_ORIGIN=

# -----------------------------------------------------------------------------
# NOTEBOOKLM ENTERPRISE — OPTIONAL
# -----------------------------------------------------------------------------
# Confirm the exact endpoint for the operator's Google Cloud deployment.
NOTEBOOKLM_API_BASE_URL=
GOOGLE_CLOUD_ACCESS_TOKEN=
NOTEBOOKLM_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# TELEGRAM EXECUTION LANE — OPTIONAL
# -----------------------------------------------------------------------------
# Put real tokens only in the operator's private .env/secret store.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org

# -----------------------------------------------------------------------------
# POSTGRESQL / E-D NARSG DURABLE SUBSYSTEM — OPTIONAL
# -----------------------------------------------------------------------------
# DATABASE_URL may be used instead of individual PG* settings.
DATABASE_URL=
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=hyperai

# -----------------------------------------------------------------------------
# OPTIONAL VERIFICATION / CANON SOURCES
# -----------------------------------------------------------------------------
JEV_WORKER_URL=
HYPERAI_VSCODE_CANON_PATH=./hyperai-vscode-canon.json
