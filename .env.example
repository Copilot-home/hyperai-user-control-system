# Example Environment Variables for HyperAI User Control System

# Active runtime contract defaults to backend/server.js on port 5000.
# Override only when the live runtime surface differs from CI/runtime truth.
# VITE_API_BASE_URL=http://localhost:5000/api
# Optional alternative to VITE_API_BASE_URL when you want the client to append /api itself.
# VITE_API_ORIGIN=http://localhost:5000
# Optional explicit WebSocket origin. When omitted, HyperAI derives ws:// or wss:// from the API origin.
# VITE_WEBSOCKET_URL=ws://localhost:5000
#
# Runtime feature flags
# VITE_ENABLE_CHAT_RUNTIME=false
# VITE_ENABLE_USER_RUNTIME=false
# VITE_ENABLE_NOTEBOOKLM_RUNTIME=false
# VITE_ENABLE_WEBSOCKET_RUNTIME=false

# NotebookLM Enterprise integration
# Set NOTEBOOKLM_API_BASE_URL to your NotebookLM Enterprise API base path.
# Example shape only; confirm the exact path in Google Cloud docs for your deployment.
# NOTEBOOKLM_API_BASE_URL=https://discoveryengine.googleapis.com/v1alpha/projects/YOUR_PROJECT/locations/global/collections/default_collection/engines/YOUR_ENGINE/assistants/default_assistant
# GOOGLE_CLOUD_ACCESS_TOKEN=your_short_lived_google_cloud_bearer_token
# NOTEBOOKLM_ACCESS_TOKEN=optional_fallback_token
# VITE_API_BASE_URL=http://localhost:5000/api
