{
    "name":  "hyperai-user-control-system",
    "version":  "1.0.0",
    "description":  "A user control system for managing interactions with the HyperAI platform.",
    "main":  "src/main.tsx",
    "scripts":  {
                    "start":  "vite",
                    "preview:ci":  "vite preview --host 127.0.0.1 --port 4173",
                    "build":  "vite build",
                    "ci:build":  "node scripts/tooling/run-vite-build.mjs",
                    "ci:docker-surface":  "node scripts/ci/validate-docker-surface.mjs",
                    "ci:browser-smoke":  "node scripts/ci/browser-agent-smoke.mjs",
                    "ci:build:isolated":  "node scripts/tooling/run-vite-build.mjs --outDir dist-isolated",
                    "ci:browser-smoke:isolated":  "node scripts/ci/run-isolated-browser-smoke.mjs",
                    "ci:autonomous-boundary-proof":  "node scripts/ci/autonomous-boundary-proof.mjs",
                    "runtime:autonomous:status":  "node scripts/runtime/inspect-runtime-authority.mjs",
                    "runtime:autonomous:cycle":  "python ../tools/hyperai_autonomous_cycle.py",
                    "runtime:autonomous:daemon":  "python ../tools/hyperai_autonomous_daemon.py --cycles 1",
                    "runtime:autonomous:ensure":  "node scripts/runtime/ensure-autonomous-runtime.mjs",
                    "runtime:docker:status":  "node scripts/runtime/check-docker-host.mjs",
                    "runtime:autonomous:drill":  "node scripts/runtime/run-failover-drill.mjs",
                    "runtime:autonomous:start":  "node scripts/runtime/start-autonomous-runtime.mjs",
                    "runtime:autonomous:stop":  "node scripts/runtime/stop-autonomous-runtime.mjs",
                    "test":  "node scripts/tooling/run-legacy-jest.mjs",
    "load-test": "k6 run load-test/k6-script.js",
                    "format":  "prettier --write ."
                },
    "dependencies":  {
                         "axios":  "^0.21.1",
                         "chart.js":  "^4.5.1",
                         "classnames":  "^2.3.1",
                         "cors":  "^2.8.6",
                         "express":  "^5.2.1",
                         "react":  "^18.3.1",
                         "react-chartjs-2":  "^5.3.1",
                         "react-dom":  "^18.3.1",
                         "react-router-dom":  "^5.3.4",
                         "react-speech-recognition":  "^4.0.1",
                         "socket.io":  "^4.8.3",
                         "socket.io-client":  "^4.0.0",
                         "vite":  "^2.6.4",
                         "ws":  "^8.20.0"
                     },
    "devDependencies":  {
                            "@testing-library/jest-dom":  "^5.17.0",
                            "@testing-library/react":  "^13.4.0",
                            "@types/jest":  "^27.5.2",
                            "@types/supertest":  "^7.2.0",
                            "@typescript-eslint/eslint-plugin":  "^5.62.0",
                            "@typescript-eslint/parser":  "^5.62.0",
                            "@vitejs/plugin-react":  "^1.3.2",
                            "eslint":  "^7.32.0",
                            "eslint-plugin-react":  "^7.37.5",
                            "eslint-plugin-react-hooks":  "^4.6.2",
                            "jest":  "^27.0.6",
                            "playwright":  "^1.53.0",
                            "prettier":  "^2.3.2",
                            "supertest":  "^7.2.2",
                            "ts-jest":  "^27.1.5",
                            "typescript":  "^4.4.3"
                        },
    "keywords":  [
                     "hyperai",
                     "user-control",
                     "react",
                     "vite"
                 ],
    "author":  "alpha_prime",
    "license":  "MIT"
}
